{
	"name": "wp-graphql-headless-login",
	"private": true,
	"engines": {
		"node": ">=24.12.0",
		"npm": ">=11.14.1"
	},
	"files": [
		"build",
		"src",
		"vendor",
		"vendor-prefixed",
		"access-functions.php",
		"activation.php",
		"deactivation.php",
		"LICENSE",
		"README.md",
		"readme.txt",
		"wp-graphql-headless-login.php"
	],
	"scripts": {
		"prepare": "lefthook install",
		"analyze-bundles": "npm run build:prod --webpack-bundle-analyzer",
		"build:dev": "cross-env NODE_ENV=development npm run build:js",
		"build:prod": "npm run clean && cross-env NODE_ENV=production npm run build:js",
		"build:js": "wp-scripts build --config ./webpack.config.js",
		"clean": "rimraf build",
		"format": "wp-scripts format",
		"generate:schema": "npm run wp-env:test -- run cli --env-cwd=wp-content/plugins/$(basename \"$(pwd)\")/ wp graphql generate-static-schema --output=tests/_output/schema.graphql",
		"lint:css": "wp-scripts lint-style",
		"lint:css:fix": "npm run lint:css -- --fix",
		"lint:js": "wp-scripts lint-js",
		"lint:js:fix": "npm run lint:js -- --fix",
		"lint:js:types": "tsc --noEmit",
		"lint:php": "npm run wp-env:test -- run cli --env-cwd=wp-content/plugins/$(basename \"$(pwd)\")/ composer run-script lint",
		"lint:php:fix": "npm run wp-env:test -- run cli --env-cwd=wp-content/plugins/$(basename \"$(pwd)\")/ composer run-script format",
		"lint:php:stan": "npm run wp-env:test -- run cli --env-cwd=wp-content/plugins/$(basename \"$(pwd)\")/ composer run-script phpstan",
		"lint:schema": "graphql-schema-linter --rules arguments-have-descriptions,defined-types-are-used,deprecations-have-a-reason,descriptions-are-capitalized,enum-values-all-caps,enum-values-have-descriptions,fields-have-descriptions,input-object-values-have-descriptions,relay-connection-arguments-spec,types-have-descriptions,types-are-capitalized tests/_output/schema.graphql",
		"plugin-zip": "wp-scripts plugin-zip",
		"start:js": "wp-scripts start --config ./webpack.config.js",
		"test:js": "vitest run",
		"test:js:coverage": "vitest run --coverage",
		"test:js:watch": "vitest watch",
		"test:js:ui": "vitest --ui",
		"test:php": "npm run wp-env:test -- run cli --env-cwd=wp-content/plugins/$(basename \"$(pwd)\")/ vendor/bin/phpunit -c phpunit.xml.dist",
		"wp-env": "wp-env",
		"wp-env:cli": "wp-env run cli --env-cwd=wp-content/plugins/$(basename \"$(pwd)\")/",
		"wp-env:test": "wp-env --config=.wp-env.test.json"
	},
	"dependencies": {
		"@wordpress/api-fetch": "7.33.1",
		"@wordpress/components": "30.6.5",
		"@wordpress/compose": "7.33.1",
		"@wordpress/core-data": "7.33.9",
		"@wordpress/data": "10.33.1",
		"@wordpress/dom-ready": "4.33.1",
		"@wordpress/hooks": "4.33.1",
		"@wordpress/i18n": "6.6.1",
		"@wordpress/icons": "11.0.1",
		"@wordpress/notices": "5.33.1",
		"clsx": "2.1.1",
		"react": "^18.3.1",
		"react-dom": "^18.3.1"
	},
	"devDependencies": {
		"@axepress/plugin-infra": "^0.1.0",
		"@babel/core": "^7.29.7",
		"@svgr/webpack": "^8.1.0",
		"@testing-library/jest-dom": "^7.0.0",
		"@testing-library/react": "^16.3.2",
		"@testing-library/user-event": "^14.6.1",
		"@types/react": "^18.3.31",
		"@types/react-dom": "^18.3.7",
		"@vitest/coverage-v8": "^4.1.10",
		"@wordpress/env": "^11.11.0",
		"@wordpress/eslint-plugin": "^25.7.0",
		"@wordpress/prettier-config": "^4.51.0",
		"@wordpress/scripts": "^33.0.0",
		"@wordpress/stylelint-config": "^24.0.0",
		"cross-env": "^10.1.0",
		"eslint-plugin-jest": "^29.16.0",
		"graphql": "^16.14.2",
		"graphql-inspector": "^0.5.1",
		"graphql-schema-linter": "^3.0.1",
		"jsdom": "^29.1.1",
		"lefthook": "^2.1.10",
		"lint-staged": "^17.2.0",
		"rimraf": "^6.1.3",
		"tsconfig-paths-webpack-plugin": "^4.2.0",
		"typescript": "^6.0.3",
		"url-loader": "^4.1.1",
		"vite-tsconfig-paths": "^6.1.1",
		"vitest": "^4.1.10",
		"webpack-remove-empty-scripts": "^1.1.1"
	},
	"overrides": {
		"prettier": "npm:wp-prettier@3",
		"react": "^18.3.1",
		"react-dom": "^18.3.1",
		"@babel/runtime@<7.27.6": "^7.27.6",
		"protobufjs@<7.5.5": "^7.5.5",
		"serialize-javascript@<7.0.5": "^7.0.4",
		"webpack-dev-server@<5.2.1": "^5.2.1"
	},
	"allowScripts": {
		"core-js@3.49.0": true,
		"core-js-pure@3.49.0": true,
		"esbuild@0.27.7": true,
		"fs-ext-extra-prebuilt@2.2.7": true,
		"lefthook@2.1.10": true,
		"unrs-resolver@1.12.2": true,
		"@parcel/watcher@2.6.0": true
	}
}
